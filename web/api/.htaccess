# API 路由配置

# 启用 URL 重写
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /api/

    # 强制 HTTPS（HTTP 301 重定向到 HTTPS）
    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP_HOST} !^localhost [NC]
    RewriteCond %{HTTP_HOST} !^127\.0\.0\.1 [NC]
    RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

    # 用户查询 API
    RewriteRule ^v1/users/(\d+)/balance$ v1/users.php [QSA,L]
    RewriteRule ^v1/users/(\d+)$ v1/users.php [QSA,L]

    # 投注记录 API
    RewriteRule ^v1/bets/(\d+)$ v1/bets.php [QSA,L]
    RewriteRule ^v1/bets$ v1/bets.php [QSA,L]

    # 交易记录 API
    RewriteRule ^v1/transactions/(\d+)$ v1/transactions.php [QSA,L]
    RewriteRule ^v1/transactions$ v1/transactions.php [QSA,L]

    # 开奖结果 API
    RewriteRule ^v1/lottery_results/latest$ v1/lottery_results.php [QSA,L]
    RewriteRule ^v1/lottery_results/([^/]+)$ v1/lottery_results.php [QSA,L]
    RewriteRule ^v1/lottery_results$ v1/lottery_results.php [QSA,L]

    # Webhook 管理 API
    RewriteRule ^v1/webhooks/(\d+)/logs$ v1/webhooks.php [QSA,L]
    RewriteRule ^v1/webhooks/(\d+)$ v1/webhooks.php [QSA,L]
    RewriteRule ^v1/webhooks$ v1/webhooks.php [QSA,L]

    # 充值提现 API
    RewriteRule ^v1/deposits$ v1/deposits.php [QSA,L]
    RewriteRule ^v1/withdrawals$ v1/withdrawals.php [QSA,L]

    # 批量查询 API
    RewriteRule ^v1/batch/(.+)$ v1/batch.php [QSA,L]

    # 统计 API
    RewriteRule ^v1/stats/(.+)$ v1/stats.php [QSA,L]

    # Token 生成 API
    RewriteRule ^v1/embed-token$ v1/tokens.php [QSA,L]
    RewriteRule ^v1/tokens/game$ v1/tokens.php [QSA,L]

    # 监控指标
    RewriteRule ^v1/metrics$ v1/metrics.php [QSA,L]

    # 游戏嵌入页面
    RewriteRule ^embed/game$ embed/game.php [QSA,L]
</IfModule>

# 安全设置
<FilesMatch "\.(sql|md|json|log)$">
    Order allow,deny
    Deny from all
</FilesMatch>

# 禁止访问隐藏文件
<FilesMatch "^\.">
    Order allow,deny
    Deny from all
</FilesMatch>

# 设置 PHP 参数
<IfModule mod_php7.c>
    php_flag display_errors Off
    php_flag log_errors On
    php_value error_log /path/to/logs/api_error.log
</IfModule>
