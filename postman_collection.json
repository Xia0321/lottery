{
    "info": {
        "name": "彩票系统 API",
        "description": "彩票系统外部 API 接口集合\n\n认证方式：API Key + HMAC-SHA256 签名\n\n使用前请在 Variables 中设置 api_key 和 api_secret",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "variable": [
        {
            "key": "base_url",
            "value": "http://localhost/api/v1",
            "type": "string"
        },
        {
            "key": "api_key",
            "value": "your_api_key_here",
            "type": "string"
        },
        {
            "key": "api_secret",
            "value": "your_api_secret_here",
            "type": "string"
        }
    ],
    "event": [
        {
            "listen": "prerequest",
            "script": {
                "type": "text/javascript",
                "exec": [
                    "// 自动生成签名",
                    "var apiKey = pm.collectionVariables.get('api_key');",
                    "var apiSecret = pm.collectionVariables.get('api_secret');",
                    "var timestamp = Math.floor(Date.now() / 1000).toString();",
                    "",
                    "var signString = apiKey + timestamp + apiSecret;",
                    "var sign = CryptoJS.HmacSHA256(signString, apiSecret).toString();",
                    "",
                    "pm.collectionVariables.set('timestamp', timestamp);",
                    "pm.collectionVariables.set('sign', sign);"
                ]
            }
        }
    ],
    "item": [
        {
            "name": "开奖结果",
            "item": [
                {
                    "name": "查询最新开奖结果",
                    "request": {
                        "method": "GET",
                        "header": [],
                        "url": {
                            "raw": "{{base_url}}/lottery_results/latest?api_key={{api_key}}&timestamp={{timestamp}}&sign={{sign}}",
                            "host": ["{{base_url}}"],
                            "path": ["lottery_results", "latest"],
                            "query": [
                                {"key": "api_key", "value": "{{api_key}}"},
                                {"key": "timestamp", "value": "{{timestamp}}"},
                                {"key": "sign", "value": "{{sign}}"}
                            ]
                        }
                    }
                },
                {
                    "name": "查询最新开奖结果（指定游戏）",
                    "request": {
                        "method": "GET",
                        "header": [],
                        "url": {
                            "raw": "{{base_url}}/lottery_results/latest?api_key={{api_key}}&timestamp={{timestamp}}&sign={{sign}}&game_id=1",
                            "host": ["{{base_url}}"],
                            "path": ["lottery_results", "latest"],
                            "query": [
                                {"key": "api_key", "value": "{{api_key}}"},
                                {"key": "timestamp", "value": "{{timestamp}}"},
                                {"key": "sign", "value": "{{sign}}"},
                                {"key": "game_id", "value": "1"}
                            ]
                        }
                    }
                },
                {
                    "name": "查询历史开奖列表",
                    "request": {
                        "method": "GET",
                        "header": [],
                        "url": {
                            "raw": "{{base_url}}/lottery_results?api_key={{api_key}}&timestamp={{timestamp}}&sign={{sign}}&page=1&page_size=10",
                            "host": ["{{base_url}}"],
                            "path": ["lottery_results"],
                            "query": [
