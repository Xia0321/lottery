                                {"key": "timestamp", "value": "{{timestamp}}"},
                                {"key": "sign", "value": "{{sign}}"},
                                {"key": "page", "value": "1"},
                                {"key": "page_size", "value": "10"}
                            ]
                        }
                    }
                }
            ]
        },
